{
  "manifest_version": 3,
  "name": "Авто-Подтверждение Присутствия (Универсальное)",
  "version": "1.3.0",
  "description": "Автоматически подтверждает ваше присутствие на вебинарах, лекциях и встречах (МТС Линк, Телемост, Zoom, SberJazz, VK Звонки, Pruffme и др.)",
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Авто-Подтверждение Присутствия",
    "default_icon": {
      "16": "icons/icon.png",
      "32": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["src/core.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "mts-link-autoconfirm@local"
    }
  }
}
